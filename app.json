{
  "expo": {
    "name": "Panadería Eduardo · Meseros",
    "slug": "appcafeteria",
    "version": "1.0.13",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "appcafeteria",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEF3C7",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.panaderiaeduardo.meseros",
      "versionCode": 13
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEF3C7",
          "image": "./assets/images/logo-negocio.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
