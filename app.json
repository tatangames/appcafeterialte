{
  "expo": {
    "name": "Panadería Eduardo · Meseros",
    "slug": "appcafeteria",
    "version": "1.0.15",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "appcafeteria",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEF3C7",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tatanstudios.panaderiacontrol",
      "versionCode": 15
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEF3C7",
          "image": "./assets/images/logo-negocio.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      },
      "url": "https://u.expo.dev/50eae372-d17d-4296-a270-51cb362b0ba0"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "50eae372-d17d-4296-a270-51cb362b0ba0"
      }
    }
  }
}
